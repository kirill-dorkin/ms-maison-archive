---
// Patron cabinet — printed ledger aesthetic: stats strip, Overview
// (privileges + residences), Orders & log (4-step craft progress),
// Settings (live currency, presentation case, notices, vault count).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Кабинет покупателя — Maison" description="Заказы, журнал, адреса и настройки покупателя.">
  <main class="mx-auto max-w-[1240px] px-2 sm:px-6">

    <div data-guest class="hidden py-24 text-center [&.show]:block">
      <div class="eti mb-4 text-acc" style="letter-spacing:0.18em">Кабинет покупателя</div>
      <h1 class="font-sf m-0 mb-5 text-[clamp(26px,4vw,40px)]">Кабинет открыт для покупателей</h1>
      <p class="mx-auto mb-7 max-w-[46ch] text-[14.5px] leading-[1.7] text-soft">Войдите по своему адресу или как один из демо-покупателей, чтобы увидеть журнал.</p>
      <button data-guest-auth class="btn-keeper px-6 py-3.5">Войти</button>
    </div>

    <div data-cabinet class="hidden [&.show]:block">
      <section class="flex flex-wrap items-end gap-x-10 gap-y-3 border-b border-line pb-4 pt-6 sm:gap-y-6 sm:pb-[30px] sm:pt-14">
        <div class="min-w-0 flex-[1_1_320px]">
          <div class="mb-2 flex items-baseline justify-between gap-4 sm:mb-[18px]">
            <span class="eti text-acc" style="letter-spacing:0.18em">Кабинет покупателя</span>
            <button data-sign-out class="eti cursor-pointer text-faint transition hover:text-acc" style="font-size:11px">Выйти</button>
          </div>
          <h1 data-p-name class="font-sf m-0 mb-3.5 text-[clamp(28px,4vw,42px)] leading-[1.1]"></h1>
          <div data-p-line class="hidden font-mono text-[11.5px] tracking-[0.04em] text-soft sm:block"></div>
        </div>
      </section>

      <section data-p-stats class="grid grid-cols-2 gap-x-4 border-b border-line sm:grid-cols-[repeat(auto-fit,minmax(150px,1fr))]"></section>

      <div class="eti flex flex-wrap items-center gap-x-[26px] gap-y-3.5 pt-[18px]" style="font-size:11px">
        <button data-cab-tab="overview" class="cursor-pointer text-soft transition hover:text-acc [&.on]:text-acc [&.on]:border-b [&.on]:border-acc [&.on]:pb-[3px]">Обзор</button>
        <button data-cab-tab="orders" class="cursor-pointer text-soft transition hover:text-acc [&.on]:text-acc [&.on]:border-b [&.on]:border-acc [&.on]:pb-[3px]">Заказы и журнал</button>
        <button data-cab-tab="settings" class="cursor-pointer text-soft transition hover:text-acc [&.on]:text-acc [&.on]:border-b [&.on]:border-acc [&.on]:pb-[3px]">Настройки</button>
      </div>

      <div class="flex flex-wrap items-start gap-x-14 gap-y-8 pt-5 sm:gap-y-11 sm:pt-[34px]" data-cab-body></div>
    </div>
  </main>

  <script>
    import { patron, vault, currency, packaging, notify, CURRENCIES, fmtMoney, type Currency } from '../lib/stores';

    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const STEPS = ['Подготовка', 'Ручная работа', 'Проверка', 'Отправлено'];
    let tab = 'overview';

    // demo ledger per patron id — new registrations get the starter ledger
    const LEDGERS: Record<string, any> = {
      p1: {
        perks: ['Доставка бронированным транспортом', 'Доступ в частные салоны Женевы и Лондона'],
        stats: [['1,284,000', 'Сумма приобретений', 1284000], ['37', 'Заказов в реестре'], ['3', 'В работе / в пути'], ['14,600', 'Бонусы'], ['21', 'В личном хранилище']],
        orders: [
          { code: 'ORD-24-0917', item: 'Вечный календарь Grand Feu · MHH-0872', usd: 312000, stage: 2, tracking: 'Трек BRV-88214' },
          { code: 'ORD-24-0864', item: 'Двубортный костюм Super 160s · KS-2210', usd: 12800, stage: 4, tracking: 'Трек BRV-87109' },
        ],
        log: [
          ['12 мая', 'Консультация у мастера турбийонов в Женеве; протокол передан в архив.'],
          ['28 апр', 'Выдан сертификат подлинности на карманный хронометр MHH-0455.'],
          ['04 мар', 'Статус повышен до «Большой коллекционер».'],
        ],
        addresses: [
          ['Основной адрес', 'Женева · приём по записи у хранителя (адрес вымышлен)'],
          ['Загородный дом', 'Вале, Швейцария · только бронированная доставка'],
        ],
      },
      p2: {
        perks: ['Приоритетная запись на примерки', 'Хранение в сейфе ателье'],
        stats: [['486,000', 'Сумма приобретений', 486000], ['14', 'Заказов в реестре'], ['1', 'В работе / в пути'], ['5,200', 'Бонусы'], ['9', 'В личном хранилище']],
        orders: [
          { code: 'ORD-24-1042', item: 'Гербовый переплёт на заказ · AB-3070', usd: 8900, stage: 1, tracking: 'Трек BRV-90417' },
        ],
        log: [
          ['02 июн', 'Третья примерка смокинга KS-2712 назначена на Сэвил-Роу.'],
          ['19 мая', 'Получен отчёт о состоянии лота AB-1751 от хранителя архива.'],
        ],
        addresses: [
          ['Основной адрес', 'Женева (адрес вымышлен)'],
          ['Городская квартира', 'Лондон · доставка в часы работы консьержа'],
        ],
      },
    };
    const STARTER = {
      perks: ['Сезонный каталог с курьером', 'Знакомство с хранителем архива'],
      stats: [['0', 'Сумма приобретений', 0], ['0', 'Заказов в реестре'], ['0', 'В работе / в пути'], ['100', 'Бонусы'], ['0', 'В личном хранилище']],
      orders: [],
      log: [['Сегодня', 'Вы зарегистрированы; хранитель открыл новый журнал.']],
      addresses: [['Основной адрес', 'Запишем на первой встрече']],
    };

    const money = (usd: number) => fmtMoney(usd, currency.get() as Currency);

    function render() {
      const p = patron.get();
      $('[data-guest]').classList.toggle('show', !p);
      $('[data-cabinet]').classList.toggle('show', !!p);
      if (!p) return;
      const led = LEDGERS[p.id] ?? STARTER;
      $('[data-p-name]').textContent = p.name;
      $('[data-p-line]').textContent = `${p.status} · ${p.registry} · member since ${p.since}`;
      $('[data-p-stats]').innerHTML = led.stats.map((s: any[], i: number) => `
        <div class="flex flex-col items-center gap-1.5 py-3.5 text-center sm:items-start sm:gap-2.5 sm:py-7 sm:pr-[22px] sm:text-left">
          <span class="font-sf text-[21px] leading-none sm:text-[28px]">${i === 0 && s[2] != null ? money(s[2]).replace(/^(.)/, '$1') : s[0]}</span>
          <span class="eti leading-[1.5] text-faint" style="font-size:10px">${s[1]}</span>
        </div>`).join('');
      document.querySelectorAll<HTMLElement>('[data-cab-tab]').forEach((b) => b.classList.toggle('on', b.dataset.cabTab === tab));

      const body = $('[data-cab-body]');
      if (tab === 'orders') {
        body.innerHTML = `
          <section class="flex min-w-0 flex-[999_1_480px] flex-col gap-6">
            <h2 class="font-sf m-0 text-[22px]">Заказы</h2>
            ${led.orders.length ? led.orders.map((o: any) => `
              <article class="flex flex-col gap-[18px] border border-line bg-card p-[22px]">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                  <span class="font-mono text-[11.5px] tracking-[0.06em] text-soft">${o.code}</span>
                  <span class="flex-1"></span>
                  <span class="font-mono text-[13px]" data-usd="${o.usd}">${money(o.usd)}</span>
                </div>
                <div class="font-sf text-[19px] leading-[1.3]">${o.item}</div>
                <div class="flex">
                  ${STEPS.map((l, n) => `
                    <div class="flex min-w-0 flex-1 flex-col gap-2">
                      <div class="mr-[3px] h-0.5 ${n < o.stage ? 'bg-acc' : 'bg-rule'}"></div>
                      <span class="eti leading-[1.5] text-faint ${n === o.stage - 1 ? '' : 'hidden sm:block'}" style="font-size:9.5px">${l}</span>
                    </div>`).join('')}
                </div>
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-soft">
                  <span>${o.tracking}</span>
                  <span class="flex-1"></span>
                  <span class="cursor-pointer text-acc">Сертификат архива</span>
                </div>
              </article>`).join('') : '<p class="m-0 text-[14px] leading-[1.7] text-muted">В этом сезоне реестр пуст. Здесь появится ваше первое приобретение.</p>'}
            <h2 class="font-sf m-0 mt-[22px] text-[22px]">Журнал</h2>
            <div class="flex flex-col">
              ${led.log.map((l: string[]) => `
                <div class="flex flex-wrap gap-x-[22px] gap-y-1.5 border-t border-line py-[15px]">
                  <span class="w-24 flex-none font-mono text-[11px] tracking-[0.04em] text-faint">${l[0]}</span>
                  <span class="min-w-0 flex-[1_1_260px] text-[14px] leading-[1.6] text-ink">${l[1]}</span>
                </div>`).join('')}
            </div>
          </section>`;
      } else if (tab === 'settings') {
        const cur = currency.get();
        const pk = packaging.get();
        const nf = notify.get() === 'on';
        body.innerHTML = `
          <section class="flex min-w-0 max-w-[560px] flex-1 flex-col gap-3.5">
            <h2 class="font-sf m-0 text-[20px]">Настройки</h2>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-3.5">
              <span class="flex-1 text-[13.5px]">Валюта</span>
              <div class="flex gap-3 font-mono text-[12px]">
                ${Object.keys(CURRENCIES).map((k) => `
                  <button data-set-cur="${k}" class="cursor-pointer ${k === cur ? 'border-b border-acc text-acc' : 'text-faint'}">${k} ${(CURRENCIES as any)[k].sign}</button>`).join('')}
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-3.5">
              <span class="flex-1 text-[13.5px]">Футляр</span>
              <div class="flex gap-3 font-mono text-[12px]">
                ${['Красное дерево', 'Телячья кожа'].map((x) => `
                  <button data-set-pack="${x}" class="cursor-pointer ${x === pk ? 'border-b border-acc text-acc' : 'text-faint'}">${x}</button>`).join('')}
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-3.5">
              <span class="flex-1 text-[13.5px]">Уведомления о покупках</span>
              <button data-set-notify class="cursor-pointer border-b border-acc font-mono text-[12px] text-acc">${nf ? 'On' : 'Выкл.'}</button>
            </div>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-3.5">
              <span class="flex-1 text-[13.5px]">Сохранённые предметы</span>
              <span class="font-mono text-[12px] text-acc">${vault.get().length}</span>
            </div>
          </section>`;
      } else {
        body.innerHTML = `
          <aside class="flex min-w-0 flex-[1_1_320px] flex-col gap-9">
            <div class="flex flex-col gap-2.5 border border-line bg-card p-5">
              <span class="eti text-faint" style="font-size:10px">Привилегии</span>
              ${led.perks.map((x: string) => `<span class="text-[13.5px] leading-[1.6] text-ink">${x}</span>`).join('')}
            </div>
          </aside>
          <section class="flex min-w-0 flex-[1_1_360px] flex-col gap-3.5">
            <h2 class="font-sf m-0 text-[20px]">Адреса</h2>
            ${led.addresses.map((a: string[]) => `
              <div class="flex flex-col gap-1.5 border-t border-line pt-3.5">
                <span class="eti text-faint" style="font-size:10px">${a[0]}</span>
                <span class="text-[13.5px] leading-[1.65] text-ink">${a[1]}</span>
              </div>`).join('')}
            <span class="eti cursor-pointer text-acc" style="font-size:11px">Добавить адрес</span>
          </section>`;
      }
    }

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const ct = t.closest<HTMLElement>('[data-cab-tab]');
      if (ct) { tab = ct.dataset.cabTab!; return render(); }
      if (t.closest('[data-sign-out]')) { patron.set(null); location.href = '/'; return; }
      if (t.closest('[data-guest-auth]')) { (window as any).maisonOpenAuth?.(); return; }
      const sc = t.closest<HTMLElement>('[data-set-cur]');
      if (sc) { currency.set(sc.dataset.setCur as any); return render(); }
      const sp = t.closest<HTMLElement>('[data-set-pack]');
      if (sp) { packaging.set(sp.dataset.setPack!); return render(); }
      if (t.closest('[data-set-notify]')) { notify.set(notify.get() === 'on' ? 'off' : 'on'); return render(); }
    });
    patron.subscribe(render);
    vault.subscribe(() => { if (tab === 'settings') render(); });
    document.addEventListener('maison:currency', render);

    render();
  </script>
</Layout>
